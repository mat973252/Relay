      "types": "./dist/src/capsule.d.ts",
      "import": "./dist/src/capsule.js"
    }
  },
  "scripts": {
    "test": "tsc -b . && node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@relay/artifact-fs": "workspace:@mat973252/relay-artifact-fs@*",
    "@relay/core": "workspace:@mat973252/relay-core@*",
    "@relay/storage-sqlite": "workspace:@mat973252/relay-storage-sqlite@*",
    "yaml": "^2.8.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "Relay cli: durable execution continuity for AI agents",
